        <mxCell id="dVHnoouk_WhtkHt9ba3J-117" value="&lt;h2 data-start=&quot;263&quot; data-end=&quot;280&quot;&gt;これは何を意味するか？&lt;/h2&gt;&lt;br&gt;&lt;div class=&quot;_tableContainer_80l1q_1&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;_tableWrapper_80l1q_14 group flex w-fit flex-col-reverse&quot;&gt;&lt;table data-start=&quot;282&quot; data-end=&quot;499&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;282&quot; data-end=&quot;293&quot;&gt;&lt;tr data-start=&quot;282&quot; data-end=&quot;293&quot;&gt;&lt;th data-start=&quot;282&quot; data-end=&quot;287&quot; data-col-size=&quot;sm&quot;&gt;項目&lt;/th&gt;&lt;th data-start=&quot;287&quot; data-end=&quot;293&quot; data-col-size=&quot;md&quot;&gt;説明&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;310&quot; data-end=&quot;499&quot;&gt;&lt;tr data-start=&quot;310&quot; data-end=&quot;370&quot;&gt;&lt;td data-start=&quot;310&quot; data-end=&quot;323&quot; data-col-size=&quot;sm&quot;&gt;GREトンネル&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;323&quot; data-end=&quot;370&quot;&gt;&lt;code data-start=&quot;325&quot; data-end=&quot;344&quot;&gt;2.2.2.2 → 1.1.1.1&lt;/code&gt; へ GRE で ICMP パケットをカプセル化&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;371&quot; data-end=&quot;438&quot;&gt;&lt;td data-start=&quot;371&quot; data-end=&quot;386&quot; data-col-size=&quot;sm&quot;&gt;実際の送信元/宛先&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;386&quot; data-end=&quot;438&quot;&gt;&lt;code data-start=&quot;388&quot; data-end=&quot;419&quot;&gt;192.168.2.254 → 192.168.1.254&lt;/code&gt;（R3のLAN → R1のLAN）&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;439&quot; data-end=&quot;499&quot;&gt;&lt;td data-start=&quot;439&quot; data-end=&quot;447&quot; data-col-size=&quot;sm&quot;&gt;&amp;nbsp;内容&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;447&quot; data-end=&quot;499&quot;&gt;ICMP（ping）パケット。おそらく &lt;strong data-start=&quot;469&quot; data-end=&quot;480&quot;&gt;R1 → R3&lt;/strong&gt; へのpingに対する&lt;strong data-start=&quot;491&quot; data-end=&quot;497&quot;&gt;応答&lt;/strong&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=7;fontColor=default;labelBackgroundColor=default;" parent="1" vertex="1">
          <mxGeometry x="479" y="1716" width="297.12" height="107" as="geometry" />
        </mxCell>
