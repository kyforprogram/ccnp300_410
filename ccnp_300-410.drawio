\ 07B85737 F3A58BE1 1A48A229 C37C1E69 39F08678\n  80DDCD16 D6BACECA EEBC7CF9\&#xa;          \ 8428787B 35202CDC 60E4616A B623CDBD 230E3AFB\n  418616A9 4093E049 4D10AB75\&#xa;          \ 27E86F73 932E35B5 8862FDAE 0275156F 719BB2F0\n  D697DF7F 28\n  \tquit\n\&#xa;          !\nlicense udi pid CSR1000V sn 9I9L5L1CPYO\ndiagnostic bootup level minimal\n\&#xa;          memory free low-watermark processor 71464\n!\n!\nspanning-tree extend system-id\n\&#xa;          !\n!\nredundancy\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n!\n\&#xa;          !\n!\n!\n!\n!\n!\n!\ninterface Tunnel0\n ip address 10.1.1.2 255.255.255.0\n\&#xa;          \ tunnel source 2.2.2.2\n tunnel destination 1.1.1.1\n!\ninterface GigabitEthernet1\n\&#xa;          \ no ip address\n shutdown\n negotiation auto\n no mop enabled\n no mop\&#xa;          \ sysid\n!\ninterface GigabitEthernet2\n ip address 2.2.2.2 255.255.255.252\n\&#xa;          \ negotiation auto\n no mop enabled\n no mop sysid\n!\ninterface GigabitEthernet3\n\&#xa;          \ ip address 192.168.2.254 255.255.255.0\n negotiation auto\n no mop enabled\n\&#xa;          \ no mop sysid\n!\ninterface GigabitEthernet4\n no ip address\n shutdown\n\&#xa;          \ negotiation auto\n no mop enabled\n no mop sysid\n!\nrouter ospf 1\n network\&#xa;          \ 10.1.1.0 0.0.0.255 area 0\n network 192.168.2.0 0.0.0.255 area 0\n!\n\&#xa;          ip forward-protocol nd\nno ip http server\nip http secure-server\n!\nip\&#xa;          \ route 1.1.1.1 255.255.255.255 2.2.2.1\n!\n!\n!\n!\n!\n!\n!\ncontrol-plane\n\&#xa;          !\n!\n!\n!\n!\n!\nline con 0\n exec-timeout 0 0\n logging synchronous\n\&#xa;          \ stopbits 1\nline vty 0\n exec-timeout 0 0\n logging synchronous\n login\n\&#xa;          \ transport input ssh\nline vty 1 4\n exec-timeout 0 0\n login\n length\&#xa;          \ 0\n transport input ssh\n!\ncall-home\n ! If contact email address in\&#xa;          \ call-home is configured as sch-smart-licensing@cisco.com\n ! the email\&#xa;  